<style>
:root{--red:#641321;--dark:#171719;--gold:#c9a45c;--light:#f5f3ef}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,sans-serif;background:var(--light);color:#222}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
a{text-decoration:none;color:inherit}
header{background:#171719;color:white;padding:15px 5%;display:flex;justify-content:space-between;align-items:center;gap:15px;position:sticky;top:0;z-index:20}
.logo{font-size:23px;font-weight:900}
.logo span{color:var(--gold)}
nav{display:flex;gap:18px;align-items:center}
nav a{font-size:13px;color:white}
.menu-btn{display:none;background:none;color:white;border:0;font-size:25px}
.hero{min-height:480px;padding:85px 7%;display:flex;align-items:center;color:white;background:linear-gradient(90deg,#170d10ed,#260e17a8,#0005),url("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1800&q=85") center/cover}
.hero-content{max-width:700px}
.hero small{color:var(--gold);font-weight:bold;letter-spacing:3px}
.hero h1{font-size:clamp(36px,6vw,65px);line-height:1.1;margin:18px 0}
.hero p{font-size:17px;line-height:1.7;color:#eee}
.btn{display:inline-block;border:0;border-radius:5px;padding:13px 20px;background:var(--gold);color:#171719;font-weight:bold;margin:15px 7px 0 0}
.btn.red{background:var(--red);color:white}
.btn.dark{background:#242426;color:white}
.section{padding:60px 6%;scroll-margin-top:75px}
.white{background:white}
.section-head{text-align:center;margin-bottom:30px}
.section-head small{color:var(--red);font-weight:bold;letter-spacing:2px}
.section-head h2{font-size:30px;margin:10px 0}
.section-head p{color:#777;line-height:1.6}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;background:var(--red);color:white;padding:30px 6%;text-align:center}
.stat strong{font-size:30px;color:var(--gold);display:block}
.about-grid,.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}
.about-grid h2{font-size:30px;margin:12px 0}
.about-grid p{line-height:1.8;color:#555;margin-bottom:12px}
.about-image{min-height:290px;border-radius:10px;background:url("https://images.unsplash.com/photo-1541976590-713941681591?auto=format&fit=crop&w=1000&q=80") center/cover}
.services,.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.service{background:white;padding:25px;border-radius:8px;border-bottom:3px solid var(--gold);box-shadow:0 4px 15px #00000010}
.service .symbol{font-size:32px;margin-bottom:12px}
.service h3{margin-bottom:9px}
.service p{font-size:14px;color:#666;line-height:1.6}
.project-tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.project-tools input,.project-tools select{padding:12px;border:1px solid #ddd;border-radius:5px;flex:1;min-width:150px}
.project-card{background:white;border-radius:8px;overflow:hidden;box-shadow:0 4px 15px #00000012}
.project-cover{height:190px;background:#e5e2dc}
.project-cover img{width:100%;height:100%;object-fit:cover}
.no-photo{height:100%;display:grid;place-items:center;font-size:45px;color:#777}
.project-info{padding:17px}
.project-info h3{margin:10px 0}
.project-info p{font-size:13px;color:#666;line-height:1.6;margin:5px 0}
.status{display:inline-block;padding:5px 9px;border-radius:20px;background:#e5f4e9;color:#16753a;font-size:11px;font-weight:bold}
.status.continue{background:#fff0d5;color:#9b6100}
.empty{grid-column:1/-1;text-align:center;padding:35px;background:white;color:#777}
.contact-box{background:white;padding:25px;border-radius:9px}
.contact-box p{margin:12px 0;color:#555;line-height:1.7}
.contact-form input,.contact-form textarea{width:100%;padding:12px;margin:7px 0;border:1px solid #ddd;border-radius:5px}
.contact-form textarea{min-height:100px}
footer{background:#171719;color:#ddd;padding:30px;text-align:center;line-height:1.8}
footer strong{color:var(--gold)}
.admin-entry{position:fixed;right:14px;bottom:14px;z-index:9999;background:var(--red);color:white;border:0;border-radius:50px;padding:14px 20px;font-weight:bold;box-shadow:0 4px 15px #0005;pointer-events:auto;touch-action:manipulation}
.modal{display:none;position:fixed;inset:0;background:#000b;z-index:10000;overflow:auto;padding:15px;align-items:center;justify-content:center}
.modal.show{display:flex}
.modal-box{background:white;width:100%;max-width:850px;max-height:92vh;overflow:auto;border-radius:10px;padding:25px;position:relative}
.close{position:absolute;right:12px;top:10px;border:0;background:#eee;border-radius:50%;width:35px;height:35px;font-size:22px}
.login-box{max-width:400px}
.login-box input{width:100%;padding:13px;margin:12px 0;border:1px solid #ddd;border-radius:5px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field{margin-bottom:12px}
.field label{display:block;font-size:13px;font-weight:bold;margin-bottom:6px}
.field input,.field textarea,.field select{width:100%;padding:12px;border:1px solid #ddd;border-radius:5px}
.field textarea{min-height:90px}
.full{grid-column:1/-1}
.admin-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px;border-bottom:1px solid #eee}
.admin-item small{display:block;color:#777;margin-top:5px}
.admin-actions{display:flex;gap:6px;flex-wrap:wrap}
.admin-actions button{padding:8px;border:0;border-radius:4px}
.edit-btn{background:#eee}
.delete-btn{background:#fee0e0;color:#a00}
.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:15px}
.gallery img,.gallery video{width:100%;max-height:300px;object-fit:cover;border-radius:6px}
.detail-text{white-space:pre-wrap;line-height:1.7;color:#555}
@media(max-width:800px){
.menu-btn{display:block}
nav{display:none;position:absolute;top:60px;left:0;right:0;background:#171719;padding:20px;flex-direction:column;align-items:flex-start}
nav.open{display:flex}
.services,.projects{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:550px){
.hero{min-height:420px;padding:55px 6%}
.section{padding:45px 5%}
.services,.projects,.about-grid,.contact-grid,.form-grid{grid-template-columns:1fr}
.stats{padding:22px 4%}
.stat strong{font-size:24px}
.modal-box{padding:20px 15px}
.admin-item{align-items:flex-start;flex-direction:column}
}
</style>
</head>
