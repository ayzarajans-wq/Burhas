<script>
(function(){
"use strict";
const ADMIN_PASSWORD="miran2121";
const PHONE="905462201521";
const STORAGE_KEY="burhas_projects_v2";
let projects=[];
let db=null;

const $=id=>document.getElementById(id);
const showModal=id=>$(id).classList.add("show");
const hideModal=id=>$(id).classList.remove("show");

function escapeHTML(v){
 return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function loadProjects(){
 try{projects=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");if(!Array.isArray(projects))projects=[];}
 catch(e){projects=[];}
}
function saveProjects(){
 localStorage.setItem(STORAGE_KEY,JSON.stringify(projects));
}
function openDB(){
 return new Promise((resolve,reject)=>{
  if(!window.indexedDB){reject(new Error("IndexedDB desteklenmiyor"));return;}
  const request=indexedDB.open("BurhasMediaDB_v2",1);
  request.onupgradeneeded=()=>{
   const d=request.result;
   if(!d.objectStoreNames.contains("media"))d.createObjectStore("media",{keyPath:"id"});
  };
  request.onsuccess=()=>{db=request.result;resolve(db);};
  request.onerror=()=>reject(request.error);
 });
}
function getMedia(id){
 return new Promise((resolve,reject)=>{
  if(!db){resolve([]);return;}
  const r=db.transaction("media","readonly").objectStore("media").get(id);
  r.onsuccess=()=>resolve(r.result?.files||[]);
  r.onerror=()=>reject(r.error);
 });
}
function putMedia(id,files){
 return new Promise((resolve,reject)=>{
  if(!db){reject(new Error("Medya depolaması açılamadı"));return;}
  const tx=db.transaction("media","readwrite");
  tx.objectStore("media").put({id,files});
  tx.oncomplete=resolve;
  tx.onerror=()=>reject(tx.error);
 });
}
function removeMedia(id){
 return new Promise(resolve=>{
  if(!db){resolve();return;}
  const tx=db.transaction("media","readwrite");
  tx.objectStore("media").delete(id);
  tx.oncomplete=resolve;
  tx.onerror=resolve;
 });
}
function toData(file){
 return new Promise((resolve,reject)=>{
  const r=new FileReader();
  r.onload=()=>resolve({name:file.name,type:file.type,data:r.result});
  r.onerror=()=>reject(r.error);
  r.readAsDataURL(file);
 });
}
function updateStats(){
 $("totalProjects").textContent=projects.length;
 $("completedProjects").textContent=projects.filter(p=>p.status==="Tamamlandı").length;
 $("ongoingProjects").textContent=projects.filter(p=>p.status==="Devam Ediyor").length;
}
async function renderProjects(){
 const list=$("projectsList");
 const q=$("searchProject").value.toLocaleLowerCase("tr");
 const status=$("filterStatus").value;
 const filtered=projects.filter(p=>{
  const s=[p.name,p.city,p.district,p.address,p.description].join(" ").toLocaleLowerCase("tr");
  return s.includes(q)&&(!status||p.status===status);
 });
 updateStats();
 if(!filtered.length){list.innerHTML='<div class="empty">Henüz proje eklenmemiş.</div>';return;}
 list.innerHTML="";
 for(const p of filtered){
  let files=[];
  try{files=await getMedia(p.id);}catch(e){}
  const cover=files.find(f=>f.type&&f.type.startsWith("image/"));
  const card=document.createElement("article");
  card.className="project-card";
  card.innerHTML='<div class="project-cover">'+(cover?'<img src="'+cover.data+'" alt="">':'<div class="no-photo">🏗️</div>')+'</div>'+
  '<div class="project-info"><span class="status '+(p.status==="Devam Ediyor"?"continue":"")+'">'+escapeHTML(p.status)+'</span>'+
  '<h3>'+escapeHTML(p.name)+'</h3><p>📍 '+escapeHTML([p.district,p.city].filter(Boolean).join(" / "))+'</p>'+
  '<p>'+escapeHTML((p.description||"").slice(0,100))+'</p>'+
  '<button type="button" class="btn red" data-detail="'+p.id+'">Projeyi İncele</button></div>';
  list.appendChild(card);
 }
}
async function showDetail(id){
 const p=projects.find(x=>x.id===id);if(!p)return;
 const files=await getMedia(id).catch(()=>[]);
 const gallery=files.map(f=>f.type&&f.type.startsWith("video/")?
 '<video controls src="'+f.data+'"></video>':
 '<img src="'+f.data+'" alt="'+escapeHTML(f.name)+'">').join("");
 $("detailContent").innerHTML=
 '<span class="status '+(p.status==="Devam Ediyor"?"continue":"")+'">'+escapeHTML(p.status)+'</span>'+
 '<h2 style="margin:12px 0">'+escapeHTML(p.name)+'</h2>'+
 '<p class="detail-text"><b>Konum:</b> '+escapeHTML([p.district,p.city].filter(Boolean).join(" / "))+'</p>'+
 '<p class="detail-text"><b>Adres:</b> '+escapeHTML(p.address||"Belirtilmedi")+'</p>'+
 '<p class="detail-text"><b>Başlangıç:</b> '+escapeHTML(p.start||"Belirtilmedi")+' | <b>Bitiş:</b> '+escapeHTML(p.end||"Belirtilmedi")+'</p>'+
 '<hr style="margin:15px 0"><h3>Yapılan Çalışmalar</h3><p class="detail-text">'+escapeHTML(p.description||"Açıklama eklenmemiş.")+'</p>'+
 (gallery?'<h3 style="margin-top:18px">Fotoğraf ve Videolar</h3><div class="gallery">'+gallery+'</div>':"")+
 '<a class="btn" target="_blank" href="https://wa.me/'+PHONE+'?text='+encodeURIComponent(p.name+" projesi hakkında bilgi almak istiyorum.")+'">Proje Hakkında Bilgi Al</a>';
 showModal("detailModal");
}
function renderAdmin(){
 const box=$("adminProjects");
 if(!projects.length){box.innerHTML="<p style='padding:15px;color:#777'>Henüz proje yok.</p>";return;}
 box.innerHTML=projects.map(p=>
 '<div class="admin-item"><div><b>'+escapeHTML(p.name)+'</b><small>'+escapeHTML(p.city)+' · '+escapeHTML(p.status)+'</small></div>'+
 '<div class="admin-actions"><button type="button" class="edit-btn" data-edit="'+p.id+'">Düzenle</button>'+
 '<button type="button" class="delete-btn" data-delete="'+p.id+'">Sil</button>'+
 '<button type="button" class="edit-btn" data-detail="'+p.id+'">Görüntüle</button></div></div>'
 ).join("");
}
function resetForm(){
 $("projectForm").reset();
 $("editId").value="";
 $("saveBtn").textContent="Projeyi Kaydet";
}
async function saveProject(event){
 event.preventDefault();
 const id=$("editId").value||("p_"+Date.now());
 const old=projects.find(p=>p.id===id);
 const p={
  id,name:$("pName").value.trim(),city:$("pCity").value.trim(),
  district:$("pDistrict").value.trim(),status:$("pStatus").value,
  address:$("pAddress").value.trim(),start:$("pStart").value,
  end:$("pEnd").value,description:$("pDescription").value.trim()
 };
 try{
  const chosen=Array.from($("pMedia").files||[]);
  const added=await Promise.all(chosen.map(toData));
  const existing=old?await getMedia(id):[];
  if(db)await putMedia(id,[...existing,...added]);
  if(old)projects=projects.map(x=>x.id===id?p:x);
  else projects.unshift(p);
  saveProjects();resetForm();renderAdmin();await renderProjects();
  alert("Proje kaydedildi.");
 }catch(e){alert("Kayıt yapılamadı. Fotoğraf/video dosyalarının boyutunu azaltıp tekrar deneyin.");}
}
function editProject(id){
 const p=projects.find(x=>x.id===id);if(!p)return;
 $("editId").value=p.id;
 $("pName").value=p.name||"";
 $("pCity").value=p.city||"";
 $("pDistrict").value=p.district||"";
 $("pStatus").value=p.status||"Tamamlandı";
 $("pAddress").value=p.address||"";
 $("pStart").value=p.start||"";
 $("pEnd").value=p.end||"";
 $("pDescription").value=p.description||"";
 $("saveBtn").textContent="Değişiklikleri Kaydet";
 $("pName").scrollIntoView({behavior:"smooth",block:"center"});
}
async function deleteProject(id){
 if(!confirm("Bu projeyi ve medya dosyalarını silmek istiyor musunuz?"))return;
 projects=projects.filter(p=>p.id!==id);
 saveProjects();await removeMedia(id);renderAdmin();renderProjects();
}
function login(){
 const pass=$("adminPassword").value;
 if(pass===ADMIN_PASSWORD){
  hideModal("loginModal");
  $("adminPassword").value="";
  $("loginError").textContent="";
  showModal("adminModal");
  renderAdmin();
 }else{
  $("loginError").textContent="Şifre hatalı. Tekrar deneyin.";
 }
}
function sendOffer(){
 const name=$("offerName").value.trim();
 const phone=$("offerPhone").value.trim();
 const city=$("offerCity").value.trim();
 const message=$("offerMessage").value.trim();
 if(!name||!phone||!message){alert("Ad, telefon ve iş açıklaması zorunludur.");return;}
 const msg="Merhaba Burhas İnşaat, teklif talebim var.\nAd Soyad: "+name+"\nTelefon: "+phone+"\nŞehir: "+city+"\nİş: "+message;
 window.open("https://wa.me/"+PHONE+"?text="+encodeURIComponent(msg),"_blank");
}

/* BUTONLARIN TAMAMI BURADA BAĞLANIR */
$("adminOpenBtn").addEventListener("click",function(){
 $("adminPassword").value="";
 $("loginError").textContent="";
 showModal("loginModal");
});
$("loginBtn").addEventListener("click",login);
$("adminPassword").addEventListener("keydown",function(e){if(e.key==="Enter")login();});
$("menuBtn").addEventListener("click",()=>$("nav").classList.toggle("open"));
$("searchProject").addEventListener("input",renderProjects);
$("filterStatus").addEventListener("change",renderProjects);
$("projectForm").addEventListener("submit",saveProject);
$("resetBtn").addEventListener("click",resetForm);
$("logoutBtn").addEventListener("click",()=>hideModal("adminModal"));
$("offerBtn").addEventListener("click",sendOffer);
document.querySelectorAll("[data-close]").forEach(btn=>{
 btn.addEventListener("click",()=>hideModal(btn.dataset.close));
});
document.addEventListener("click",function(e){
 const detail=e.target.closest("[data-detail]");
 const edit=e.target.closest("[data-edit]");
 const del=e.target.closest("[data-delete]");
 if(detail)showDetail(detail.dataset.detail);
 if(edit)editProject(edit.dataset.edit);
 if(del)deleteProject(del.dataset.delete);
});
document.querySelectorAll(".modal").forEach(modal=>{
 modal.addEventListener("click",e=>{if(e.target===modal)modal.classList.remove("show");});
});
$("year").textContent=new Date().getFullYear();

loadProjects();
openDB().then(()=>renderProjects()).catch(err=>{
 console.warn("Medya depolama açılamadı:",err);
 renderProjects();
});
})();
</script>
